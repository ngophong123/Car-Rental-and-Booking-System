# Database configuration (Neon PostgreSQL or Local PostgreSQL)
# Local: DATABASE_URL="postgresql://postgres:postgres@localhost:5432/minhkhoa_db?schema=public"
# Neon: DATABASE_URL="postgresql://user:password@ep-sample-pooler.region.neon.tech/neondb?sslmode=require"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/minhkhoa_db?schema=public"

# Redis configuration
# - Local Docker: redis://localhost:6379
# - Cloud Upstash: rediss://default:your_password@your_endpoint.upstash.io:6379
REDIS_URL="redis://localhost:6379"

# JWT Secrets (Change these to long, secure random keys in production)
JWT_ACCESS_SECRET="change_me_to_a_secure_random_32_character_access_secret"
JWT_REFRESH_SECRET="change_me_to_a_secure_random_32_character_refresh_secret"
ACCESS_TOKEN_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"

# Frontend & Socket URLs
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
SOCKET_URL="http://localhost:4000"
FRONTEND_URL="http://localhost:3000"

# Backend configuration
PORT=4000
NODE_ENV="development"
